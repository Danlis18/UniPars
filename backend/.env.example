# demo — демо-дані в пам'яті та демо-вхід; supabase — реальна база
APP_MODE=demo

# --- Supabase (APP_MODE=supabase) ---
SUPABASE_URL=
# Service-role ключ: ТІЛЬКИ на сервері, ніколи не у frontend
SUPABASE_SERVICE_ROLE_KEY=
# Для старих проєктів із симетричним JWT-секретом. Якщо порожньо — перевірка через JWKS.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=attachments

# --- AI ---
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_RATE_LIMIT_PER_MINUTE=10

# --- Файли ---
MAX_UPLOAD_MB=25
# Секрет для підпису тимчасових посилань на файли в демо-режимі
FILE_LINK_SECRET=change-me

# --- Новини ---
NEWS_SYNC_INTERVAL_SECONDS=600

CORS_ORIGINS=http://localhost:5173
